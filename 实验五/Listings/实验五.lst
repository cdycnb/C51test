  44          // 设置LCD显示位置
  45          void LCD_SetCursor(unsigned char Line, unsigned char Column)
  46          {
  47   1       if(Line==1)
  48   1       {
  49   2        LCD_WriteCommand(0x80|(Column-1));
  50   2       }
