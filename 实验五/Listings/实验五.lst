  56          // 初始化LCD
  57          void LCD_Init()
  58          {
  59   1       LCD_WriteCommand(0x38);//八位数据接口，两行显示，5*7点阵
  60   1       LCD_WriteCommand(0x0c);//显示开，光标关，闪烁关
  61   1       LCD_WriteCommand(0x06);//数据读写操作后，光标自动加一，画面不动
  62   1       LCD_WriteCommand(0x01);//光标复位，清屏
  63   1      }
  64          
  65          // 在指定位置显示字符串
  66          void LCD_ShowString(unsigned char Line, unsigned char Column, char *String)
  67          {
  68   1       unsigned char i;
  69   1       LCD_SetCursor(Line, Column);
  70   1       for(i=0; String[i]!='\0'; i++)
  71   1       {
  72   2        LCD_WriteData(String[i]);
  73   2       }
  74   1      }
