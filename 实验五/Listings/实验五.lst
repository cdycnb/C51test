   7          // 定义LCD延时函数，适用于12MHz时钟
   8          void LCD_Delay()    
   9          {
  10   1       unsigned char i, j;
  11   1      
  12   1       i = 12;
  13   1       j = 169;
  14   1       do
  15   1       {
  16   2        while (--j);
  17   2       } while (--i);
  18   1      }
  19          
  20          // 写入命令到LCD
  21          void LCD_WriteCommand(unsigned char Command)
  22          {
  23   1       LCD_RS=0;//命令状态
  24   1       LCD_RW=0;
  25   1       LCD_DataPort=Command;
  26   1       LCD_E=1;//E引脚用于同步数据传输
  27   1       LCD_Delay();
