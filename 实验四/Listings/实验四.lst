   6          unsigned char seg_code[10] = {0xc0, 0xf9, 0xa4, 0xb0, 0x99, 0x92, 0x82, 0xf8, 0x80, 0x90};
   7          
   8          void Delay1ms()   //@12MHz
   9          {
